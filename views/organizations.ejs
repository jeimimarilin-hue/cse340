<%- include('partials/header') %>

<h2><%= title %></h2>
<p>Explore the organizations we collaborate with:</p>

<% if (locals.organizations && organizations.length > 0) { %>
  <% organizations.forEach(org => { %>
    <section class="org-card">
      <% if (org.logo_url) { %>
        <img src="<%= org.logo_url %>" alt="<%= org.organization_name %> Logo" class="org-logo">
      <% } %>
      <div>
        <h3>
          <a href="/organization/<%= org.organization_id %>"><%= org.organization_name %></a>
        </h3>
        <p><%= org.description %></p>
      </div>
    </section>
  <% }) %>
<% } else { %>
  <p>No organizations available.</p>
<% } %>

<%- include('partials/footer') %>