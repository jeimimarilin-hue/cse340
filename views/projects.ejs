<%- include('partials/header') %>

<h2><%= title %></h2>
<p>Discover ongoing and upcoming service projects.</p>

<% if (locals.projects && projects.length > 0) { %>
  <ul>
    <% projects.forEach(project => { %>
      <li>
        <strong><a href="/project/<%= project.project_id %>"><%= project.project_name %></a></strong>: 
        <%= project.description %>
        <% if (project.organization_name) { %>
          <br><small>Partner Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></small>
        <% } %>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No projects available.</p>
<% } %>

<%- include('partials/footer') %>